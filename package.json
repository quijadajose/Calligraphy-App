{
  "name": "calligraphy-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "chardata": "node scripts/fetch-chardata.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && node scripts/fetch-chardata.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dictation": "node scripts/dictation/cli.mjs",
    "dictation:build": "node scripts/dictation/cli.mjs build",
    "audio:list": "tsx scripts/dictation/audio-list.ts",
    "audio": "tsx scripts/dictation/audio-list.ts && python3 scripts/dictation/audio.py"
  },
  "devDependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/playwrite-es": "^5.3.0",
    "@tabler/icons": "^3.48.0",
    "@types/node": "^26.6.4",
    "kuromoji": "^0.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.3"
  }
}
